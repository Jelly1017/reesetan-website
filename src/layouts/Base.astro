---
// src/layouts/Base.astro
// The base layout every page extends. Sets up:
//   - <html lang>, meta charset, viewport
//   - global stylesheet imports
//   - <head> meta + SEO
//   - skip link, Nav, slot, Footer, WhatsApp float, theme script
//   - JSON-LD structured data (passed in or built from props)

import '../styles/globals.css';
import Nav from '../components/chrome/Nav.astro';
import Footer from '../components/chrome/Footer.astro';
import WhatsAppFloat from '../components/chrome/WhatsAppFloat.astro';
import { pageMeta, getSiteUrl } from '../lib/seo';
import { getLocaleFromPath, type Locale } from '../lib/i18n';
import type { CollectionEntry } from 'astro:content';

export interface Props {
  title: string;
  description: string;
  path: string;            // e.g. "/", "/about", "/zh/training"
  ogImage?: string;
  type?: 'website' | 'article';
  jsonLd?: object | object[];
  /** Optional — sets a section class on main for styling hooks */
  sectionClass?: string;
  /** Set true to hide the nav (e.g. for /admin) */
  hideNav?: boolean;
  hideFooter?: boolean;
  hideWhatsApp?: boolean;
}

const { title, description, path, ogImage, type, jsonLd, sectionClass, hideNav, hideFooter, hideWhatsApp } = Astro.props;
const meta = pageMeta({ title, description, locale: getLocaleFromPath(Astro.url.pathname), path, ogImage, type });
const locale: Locale = getLocaleFromPath(Astro.url.pathname);
const siteUrl = getSiteUrl();
// fullTitle now comes from pageMeta so it matches og:title and twitter:title
const fullTitle = meta.title;
const jsonLdArray = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang={locale === 'zh' ? 'zh-Hans' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary SEO -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large" />
    <meta name="theme-color" content="#faf8f3" />
    <link rel="canonical" href={meta.canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content={meta.openGraph.type} />
    <meta property="og:url" content={meta.openGraph.url} />
    <meta property="og:title" content={meta.openGraph.title} />
    <meta property="og:description" content={meta.openGraph.description} />
    <meta property="og:image" content={meta.openGraph.image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={meta.openGraph.siteName} />
    <meta property="og:locale" content={meta.openGraph.locale} />

    <!-- Twitter -->
    <meta name="twitter:card" content={meta.twitter.card} />
    <meta name="twitter:title" content={meta.twitter.title} />
    <meta name="twitter:description" content={meta.twitter.description} />
    <meta name="twitter:image" content={meta.twitter.image} />

    <!-- Hreflang -->
    {Object.entries(meta.alternates.languages).map(([lang, href]) => (
      <link rel="alternate" hreflang={lang} href={href} />
    ))}

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/images/favicon.ico" />

    <!-- JSON-LD structured data -->
    {jsonLdArray.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <!-- Preconnect to font CDN (will be removed once fonts are self-hosted) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>

  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>

    {!hideNav && <Nav locale={locale} />}

    <main id="main-content" class={sectionClass}>
      <slot />
    </main>

    {!hideFooter && <Footer locale={locale} />}
    {!hideWhatsApp && <WhatsAppFloat />}

    <!-- Theme toggle (light/dark) — wired up here so it works on every page -->
    <script is:inline>
      (function() {
        const stored = localStorage.getItem('rt-theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = stored || (prefersDark ? 'dark' : 'light');
        if (theme === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
      })();
    </script>
  </body>
</html>
