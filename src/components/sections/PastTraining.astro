---
// src/components/sections/PastTraining.astro
// Gallery of past training events — uniform 4:3 box grid.
// Every card is exactly the same size: image at aspect-ratio 4/3 + caption row.
// Posters use object-position: top so the title text is never cropped.

export interface Props { locale: 'en' | 'zh'; }
const { locale } = Astro.props;
const isZh = locale === 'zh';

// Curated gallery of real past training
const photos = [
  { src: '/images/training-classroom-funnel.jpg', alt: 'Full training room with 30+ attendees', caption: 'Recent Cohort · 2026' },
  { src: '/images/training-funnel-coral.jpg', alt: 'Reese presenting the lead-conversion framework', caption: 'Lead-Funnel Workshop · 2025' },
  { src: '/images/training-group-v2.jpg', alt: 'Group training cohort', caption: 'Group Cohort · 2026' },
  { src: '/images/training-large-room.jpg', alt: 'Large training room in session', caption: 'Full Room · 2026' },
  { src: '/images/training-presenter-coral.jpg', alt: 'Reese presenting on stage', caption: 'Stage Talk · 2025' },
  { src: '/images/event-poster-aug13-hartamas.jpg', alt: 'AI-Powered Real Estate event poster', caption: 'AI Real Estate · Aug 2025', poster: true },
  { src: '/images/training-group-large.webp', alt: 'Group training session', caption: 'Group Training · 2024' },
  { src: '/images/training-group-hartamas.webp', alt: 'Hartamas group training', caption: 'Hartamas Cohort · 2024' },
  { src: '/images/training-group1.jpg', alt: 'Training in action', caption: 'Workshop · 2024' },
  { src: '/images/poster-oct28-v1.png', alt: 'Event poster October 28 v1', caption: 'Event · Oct 28 (v1)', poster: true },
  { src: '/images/poster-oct28-v2.png', alt: 'Event poster October 28 v2', caption: 'Event · Oct 28 (v2)', poster: true },
  { src: '/images/poster-jan16-sales.png', alt: 'Sales event poster Jan 16', caption: 'Sales Workshop · Jan 16', poster: true },
  { src: '/images/poster-mar21-canva.png', alt: 'Canva workshop poster Mar 21', caption: 'Canva Workshop · Mar 21', poster: true },
  { src: '/images/poster-may22.png', alt: 'May 22 event poster', caption: 'Event · May 22', poster: true },
  { src: '/images/poster-feb2026.jpg', alt: 'February 2026 poster', caption: 'Workshop · Feb 2026', poster: true },
];
---

<section class="section section--alt" id="past-training">
  <div class="container-2xl">
    <div style="text-align: center; max-width: 600px; margin: 0 auto 48px;">
      <span class="badge badge--outlined" style="margin-bottom: 12px;">{isZh ? '过往培训' : 'Past Training'}</span>
      <h2 style="margin: 0 0 12px;">
        {isZh ? '看看我们的课堂' : 'See the room'}
      </h2>
      <p style="color: var(--muted-foreground);">
        {isZh ? '500+ 专业人士,无数场实战培训。' : '500+ professionals trained across dozens of real, hands-on sessions.'}
      </p>
    </div>

    <div class="gallery-grid">
      {photos.map(p => (
        <figure class="gallery-card">
          <div class="gallery-card__media">
            <img
              src={p.src}
              alt={p.alt}
              class={p.poster ? 'gallery-card__img gallery-card__img--poster' : 'gallery-card__img'}
              loading="lazy"
              width="600"
              height="450"
            />
          </div>
          <figcaption class="gallery-card__cap">{p.caption}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .gallery-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
  }
  @media (min-width: 640px) {
    .gallery-grid { grid-template-columns: repeat(2, 1fr); gap: 14px; }
  }
  @media (min-width: 1024px) {
    .gallery-grid { grid-template-columns: repeat(3, 1fr); gap: 16px; }
  }

  /* Every card is exactly the same size — uniform "box" */
  .gallery-card {
    margin: 0;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--card);
    overflow: hidden;
    transition: border-color 200ms ease, transform 200ms ease, box-shadow 200ms ease;
  }
  .gallery-card:hover {
    border-color: var(--primary);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px oklch(0% 0 0 / 0.08);
  }

  /* Media: fixed 4:3 box for every image — this is what makes the grid uniform */
  .gallery-card__media {
    position: relative;
    aspect-ratio: 4 / 3;
    background: var(--muted);
    overflow: hidden;
  }
  .gallery-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }
  /* Posters are taller than 4:3 — anchor to the top so the title text is never cropped */
  .gallery-card__img--poster {
    object-position: center top;
  }

  /* Caption row: fixed height so every card ends at the same line */
  .gallery-card__cap {
    padding: 10px 14px;
    font-size: 13px;
    font-weight: 500;
    color: var(--foreground);
    line-height: 1.3;
    min-height: 42px;
    display: flex;
    align-items: center;
    border-top: 1px solid var(--border);
    background: var(--card);
  }
</style>
