---
// src/components/sections/PastTraining.astro
// Past training section split into 2 clean subsections:
//   1. Course posters  (vertical marketing materials — uniform 3:4 boxes)
//   2. In the room     (real training photos      — uniform 4:3 boxes)
// Each card has a consistent caption row + hover lift.

export interface Props { locale: 'en' | 'zh'; }
const { locale } = Astro.props;
const isZh = locale === 'zh';

// Course posters (vertical event marketing materials)
const posters = [
  { src: '/images/poster-dec18-mastering-ai.jpg', alt: 'Mastering AI: Smart Prompts, Sharp Writing, Solid Research — December 18 event', caption: 'Mastering AI · Dec 18 (Thu)' },
  { src: '/images/poster-feb12-mastering-ai.jpg', alt: 'Mastering AI: Smart Prompts, Sharp Writing, Solid Research — February 12 event', caption: 'Mastering AI · Feb 12 (Thu)' },
  { src: '/images/poster-jul21-mastering-ai.jpg', alt: 'Mastering AI: Smart Prompts, Sharp Writing, Solid Research — July 21 event', caption: 'Mastering AI · Jul 21 (Tue)' },
  { src: '/images/poster-oct28-v2.png', alt: 'Mastering AI event poster — October 28', caption: 'Mastering AI · Oct 28' },
  { src: '/images/event-poster-aug13-hartamas.jpg', alt: 'AI-Powered Real Estate event poster — August 13', caption: 'AI Real Estate · Aug 13' },
  { src: '/images/poster-jan16-sales.png', alt: 'Sales workshop event poster — January 16', caption: 'Sales Workshop · Jan 16' },
  { src: '/images/poster-mar21-canva.png', alt: 'Canva workshop event poster — March 21', caption: 'Canva Workshop · Mar 21' },
  { src: '/images/poster-may22.png', alt: 'Event poster — May 22', caption: 'Real Estate · May 22' },
  { src: '/images/poster-feb2026.jpg', alt: 'Event poster — February 2026', caption: 'Workshop · Feb 2026' },
];

// Real training photos (proof of execution)
const photos = [
  { src: '/images/training-classroom-funnel.jpg', alt: 'Full training room with 30+ attendees', caption: 'Recent Cohort · 2026' },
  { src: '/images/training-funnel-coral.jpg', alt: 'Reese presenting the lead-conversion framework', caption: 'Lead-Funnel Workshop · 2025' },
  { src: '/images/training-group-v2.jpg', alt: 'Group training cohort', caption: 'Group Cohort · 2026' },
  { src: '/images/training-group-large.webp', alt: 'Group training session', caption: 'Group Training · 2024' },
  { src: '/images/training-group-hartamas.webp', alt: 'Hartamas group training', caption: 'Hartamas Cohort · 2024' },
  { src: '/images/training-group1.jpg', alt: 'Training in action', caption: 'Workshop · 2024' },
];
---

<section class="section section--alt" id="past-training">
  <div class="container-2xl">

    <!-- Master heading -->
    <div style="text-align: center; max-width: 640px; margin: 0 auto 72px;">
      <span class="badge badge--outlined" style="margin-bottom: 12px;">{isZh ? '过往培训' : 'Past Training'}</span>
      <h2 style="margin: 0 0 16px;">
        {isZh ? '看看我们的课堂' : 'See the room'}
      </h2>
      <p style="color: var(--muted-foreground); font-size: 1.0625rem; line-height: 1.6; margin: 0;">
        {isZh
          ? '500+ 专业人士,无数场实战培训。HRDC 认证 · LPPEH 批准 · HRD Corp 可报销。'
          : '500+ professionals trained across dozens of real, hands-on sessions. HRDC Accredited · LPPEH 5 CPD Hours · HRD Corp Claimable.'}
      </p>
    </div>

    <!-- ============================================================ -->
    <!-- SUBSECTION 1: Course posters                                -->
    <!-- ============================================================ -->
    <div class="pt-subsection">
      <div class="pt-subsection__head">
        <span class="pt-subsection__index">01</span>
        <div>
          <h3 class="pt-subsection__title">
            {isZh ? '课程海报' : 'Course announcements'}
          </h3>
          <p class="pt-subsection__sub">
            {isZh
              ? 'Mastering AI 主课与专项工作坊的官方宣传材料。'
              : 'Official marketing materials from the Mastering AI programme and specialty workshops.'}
          </p>
        </div>
      </div>
      <div class="gallery-grid gallery-grid--posters">
        {posters.map(p => (
          <figure class="gallery-card gallery-card--poster">
            <div class="gallery-card__media">
              <img
                src={p.src}
                alt={p.alt}
                class="gallery-card__img"
                loading="lazy"
                width="600"
                height="800"
              />
            </div>
            <figcaption class="gallery-card__cap">{p.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>

    <!-- ============================================================ -->
    <!-- SUBSECTION 2: In the room (real training photos)           -->
    <!-- ============================================================ -->
    <div class="pt-subsection">
      <div class="pt-subsection__head">
        <span class="pt-subsection__index">02</span>
        <div>
          <h3 class="pt-subsection__title">
            {isZh ? '真实课堂' : 'In the room'}
          </h3>
          <p class="pt-subsection__sub">
            {isZh
              ? '不是摆拍,不是幻灯片 — 这是真实课堂上的样子。'
              : 'Not staged. Not slides. What the room actually looks like during a real training session.'}
          </p>
        </div>
      </div>
      <div class="gallery-grid gallery-grid--photos">
        {photos.map(p => (
          <figure class="gallery-card">
            <div class="gallery-card__media">
              <img
                src={p.src}
                alt={p.alt}
                class="gallery-card__img"
                loading="lazy"
                width="600"
                height="450"
              />
            </div>
            <figcaption class="gallery-card__cap">{p.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>

  </div>
</section>

<style>
  /* ------------------------------------------------------------ */
  /* Subsection heading — left-aligned, editorial style           */
  /* ------------------------------------------------------------ */
  .pt-subsection {
    margin-bottom: 96px;
  }
  .pt-subsection:last-child { margin-bottom: 0; }

  .pt-subsection__head {
    display: flex;
    align-items: flex-start;
    gap: 20px;
    margin-bottom: 32px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--border);
  }
  .pt-subsection__index {
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 600;
    color: var(--primary);
    line-height: 1;
    padding-top: 6px;
    letter-spacing: 0.05em;
  }
  .pt-subsection__title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2vw + 0.5rem, 2rem);
    font-weight: 700;
    line-height: 1.1;
    margin: 0 0 6px;
    color: var(--foreground);
  }
  .pt-subsection__sub {
    font-size: 14px;
    line-height: 1.5;
    color: var(--muted-foreground);
    margin: 0;
    max-width: 56ch;
  }

  /* ------------------------------------------------------------ */
  /* Grid: 4 cols for posters (narrow vertical), 3 cols for photos */
  /* ------------------------------------------------------------ */
  .gallery-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
  }
  @media (min-width: 640px) {
    .gallery-grid { grid-template-columns: repeat(2, 1fr); gap: 16px; }
  }
  @media (min-width: 1024px) {
    .gallery-grid--posters { grid-template-columns: repeat(4, 1fr); gap: 18px; }
    .gallery-grid--photos  { grid-template-columns: repeat(3, 1fr); gap: 18px; }
  }

  /* ------------------------------------------------------------ */
  /* Card: identical styling for posters + photos                */
  /* ------------------------------------------------------------ */
  .gallery-card {
    margin: 0;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--card);
    overflow: hidden;
    transition: border-color 200ms ease, transform 200ms ease, box-shadow 200ms ease;
  }
  .gallery-card:hover {
    border-color: var(--primary);
    transform: translateY(-3px);
    box-shadow: 0 12px 28px oklch(0% 0 0 / 0.08);
  }

  /* Media box: 3:4 for posters (vertical), 4:3 for photos (landscape) */
  .gallery-card__media {
    position: relative;
    background: var(--muted);
    overflow: hidden;
  }
  .gallery-card--poster .gallery-card__media { aspect-ratio: 3 / 4; }
  .gallery-card:not(.gallery-card--poster) .gallery-card__media { aspect-ratio: 4 / 3; }

  .gallery-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top; /* anchor to top so poster titles stay visible */
    display: block;
  }

  /* Caption row: fixed min-height so every card ends at the same line */
  .gallery-card__cap {
    padding: 12px 14px;
    font-size: 13px;
    font-weight: 500;
    color: var(--foreground);
    line-height: 1.3;
    min-height: 44px;
    display: flex;
    align-items: center;
    border-top: 1px solid var(--border);
    background: var(--card);
  }
</style>
