---
// src/components/sections/Contact.astro
// Contact form (React island) + contact card on the right.

import ContactForm from '../crm/ContactForm.tsx';

export interface Props { locale: 'en' | 'zh'; }
const { locale } = Astro.props;
const isZh = locale === 'zh';
---

<section class="section" id="contact">
  <div class="container-2xl">
    <div style="display: grid; grid-template-columns: 1fr; gap: 48px;" class="contact-grid">
      <style>
        @media (min-width: 1024px) {
          .contact-grid { grid-template-columns: 7fr 5fr !important; gap: 64px !important; }
        }
      </style>

      <!-- Form (left, 7 cols) -->
      <div>
        <span class="badge badge--outlined" style="margin-bottom: 12px;">{isZh ? '联系我们' : 'Get in touch'}</span>
        <h2 style="margin: 0 0 16px;">
          {isZh ? '告诉我们您的目标' : 'Tell us about your goals'}
        </h2>
        <p style="color: var(--muted-foreground); margin-bottom: 32px;">
          {isZh
            ? '填写下面的表单,24 小时内回复您。'
            : 'Fill in the form and we\'ll be in touch within 24 hours.'}
        </p>

        <ContactForm client:load locale={locale} />
      </div>

      <!-- Contact card (right, 5 cols) -->
      <div>
        <div class="card" style="padding: 32px;">
          <h3 style="margin: 0 0 24px; font-size: 1.25rem;">{isZh ? '直接联系' : 'Direct contact'}</h3>

          <div style="display: flex; flex-direction: column; gap: 20px;">
            <div>
              <div style="font-size: 12px; color: var(--muted-foreground); text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600; margin-bottom: 4px;">WhatsApp</div>
              <a href="https://wa.me/60163356790" target="_blank" rel="noopener" style="font-size: 1.0625rem; color: var(--primary); font-weight: 500;">
                +60 16-335 6790
              </a>
              <div style="font-size: 13px; color: var(--muted-foreground);">{isZh ? '首选联系方式' : 'Preferred contact method'}</div>
            </div>

            <div>
              <div style="font-size: 12px; color: var(--muted-foreground); text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600; margin-bottom: 4px;">Email</div>
              <a href="mailto:hello@reesetan.com" style="font-size: 1.0625rem;">hello@reesetan.com</a>
            </div>

            <div>
              <div style="font-size: 12px; color: var(--muted-foreground); text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600; margin-bottom: 4px;">{isZh ? '地址' : 'Address'}</div>
              <div style="font-size: 14px; line-height: 1.5;">
                Level 13, Block A, Menara Prima<br>
                Jalan PJU 1/37, Dataran Prima<br>
                47301 Petaling Jaya, Selangor
              </div>
            </div>

            <div>
              <div style="font-size: 12px; color: var(--muted-foreground); text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600; margin-bottom: 4px;">{isZh ? '工作时间' : 'Hours'}</div>
              <div style="font-size: 14px;">{isZh ? '周一至周五 9:00–18:00' : 'Mon–Fri 9:00–18:00 MYT'}</div>
            </div>
          </div>

          <hr style="margin: 24px 0; border: none; border-top: 1px solid var(--border);" />

          <div>
            <div style="font-size: 12px; color: var(--muted-foreground); text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600; margin-bottom: 12px;">{isZh ? '关注我' : 'Follow'}</div>
            <div style="display: flex; gap: 12px;">
              <a href="https://www.linkedin.com/in/reesetan/" target="_blank" rel="noopener" class="badge badge--subtle">
                LinkedIn
              </a>
              <a href="https://www.facebook.com/HartamasAcademy" target="_blank" rel="noopener" class="badge badge--subtle">
                Facebook
              </a>
            </div>
          </div>
        </div>

        <!-- Map -->
        <div style="margin-top: 16px; border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--border); aspect-ratio: 4/3;">
          <iframe
            src="https://www.openstreetmap.org/export/embed.html?bbox=101.5945%2C3.0994%2C101.6185%2C3.1154&layer=mapnik&marker=3.1074%2C101.6065"
            style="width: 100%; height: 100%; border: 0;"
            title="Office location map"
            loading="lazy"
          ></iframe>
        </div>
      </div>
    </div>
  </div>
</section>
