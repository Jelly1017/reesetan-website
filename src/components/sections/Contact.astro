---
// src/components/sections/Contact.astro
// Contact form (React island) + contact card on the right.

import ContactForm from '../crm/ContactForm.tsx';

export interface Props { locale: 'en' | 'zh'; }
const { locale } = Astro.props;
const isZh = locale === 'zh';
---

<section class="section" id="contact">
  <div class="container-2xl">
    <div style="display: grid; grid-template-columns: 1fr; gap: 48px;" class="contact-grid">
      <style>
        @media (min-width: 1024px) {
          .contact-grid { grid-template-columns: 7fr 5fr !important; gap: 64px !important; }
        }
      </style>

      <!-- Form (left, 7 cols) -->
      <div>
        <span class="badge badge--outlined" style="margin-bottom: 12px;">{isZh ? '联系我们' : 'Get in touch'}</span>
        <h2 style="margin: 0 0 16px;">
          {isZh ? '告诉我们您的目标' : 'Tell us about your goals'}
        </h2>
        <p style="color: var(--muted-foreground); margin-bottom: 32px;">
          {isZh
            ? '填写下面的表单,24 小时内回复您。'
            : 'Fill in the form and we\'ll be in touch within 24 hours.'}
        </p>

        <ContactForm client:load locale={locale} />
      </div>

      <!-- Contact card (right, 5 cols) -->
      <div>
        <div class="card" style="padding: 32px;">
          <h3 style="margin: 0 0 24px; font-size: 1.25rem;">{isZh ? '直接联系' : 'Direct contact'}</h3>

          <div style="display: flex; flex-direction: column; gap: 20px;">
            <div>
              <div class="contact-label">{isZh ? 'WhatsApp' : 'WhatsApp'}</div>
              <a href="https://wa.me/60163356790" target="_blank" rel="noopener" class="contact-value contact-value--primary">
                +60 16-335 6790
              </a>
              <div class="contact-sub">{isZh ? '首选联系方式' : 'Preferred contact method'}</div>
            </div>

            <div>
              <div class="contact-label">{isZh ? '邮箱' : 'Email'}</div>
              <a href="mailto:hello@reesetan.com" class="contact-value">hello@reesetan.com</a>
            </div>

            <div>
              <div class="contact-label">{isZh ? '工作时间' : 'Hours'}</div>
              <div class="contact-value contact-value--plain">{isZh ? '周一至周五 9:00–18:00' : 'Mon–Fri 9:00–18:00 MYT'}</div>
            </div>
          </div>

          <hr style="margin: 24px 0; border: none; border-top: 1px solid var(--border);" />

          <div>
            <div class="contact-label">{isZh ? '关注我' : 'Follow'}</div>
            <div style="display: flex; gap: 12px;">
              <a href="https://www.linkedin.com/in/reesetan/" target="_blank" rel="noopener" class="badge badge--subtle">
                LinkedIn
              </a>
              <a href="https://www.facebook.com/HartamasAcademy" target="_blank" rel="noopener" class="badge badge--subtle">
                Facebook
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Direct contact card — single, consistent type scale */
  .contact-label {
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    line-height: 1;
    color: var(--muted-foreground);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 8px;
  }
  .contact-value {
    display: block;
    font-family: var(--font-sans);
    font-size: 1.0625rem;   /* 17px */
    font-weight: 500;
    line-height: 1.45;
    color: var(--foreground);
    text-decoration: none;
  }
  .contact-value:hover { color: var(--primary); }
  .contact-value--primary { color: var(--primary); }
  .contact-value--primary:hover { color: var(--primary-hover); }
  .contact-value--plain { color: var(--foreground); text-decoration: none; }
  .contact-sub {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 400;
    line-height: 1.5;
    color: var(--muted-foreground);
    margin-top: 4px;
  }
</style>
