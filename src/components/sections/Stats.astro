---
// src/components/sections/Stats.astro
// Dark editorial "Why Now" band with 4 sourced Malaysia AI stats.
// Sits between Hero and About to set urgency before the visitor
// reads who Reese is and what the services are.

export interface Props {
  locale: 'en' | 'zh';
}
const { locale } = Astro.props;
const isZh = locale === 'zh';

const stats = isZh ? [
  {
    n: 'US$115B',
    label: 'AI 预计到 2030 年对马来西亚 GDP 的贡献',
    src: 'Microsoft · Kearney',
  },
  {
    n: '70%',
    label: '马来西亚企业已在至少一个业务环节中使用 AI',
    src: 'IBM 全球 AI 采用调查 2024',
  },
  {
    n: '63%',
    label: '马来西亚 CEO 认为 AI 是未来两年增长的关键',
    src: 'IDC 亚太 CEO 调查',
  },
  {
    n: 'RM 15.7B',
    label: '马来西亚 AI 市场规模,每年增长约 30%',
    src: 'MDEC · Statista',
  },
] : [
  {
    n: 'US$115B',
    label: 'AI\'s projected contribution to Malaysia\'s GDP by 2030',
    src: 'Microsoft · Kearney',
  },
  {
    n: '70%',
    label: 'Malaysian organisations now use AI in at least one function',
    src: 'IBM Global AI Adoption 2024',
  },
  {
    n: '63%',
    label: 'Malaysian CEOs say AI is critical to growth in 2 years',
    src: 'IDC Asia/Pacific CEO Survey',
  },
  {
    n: 'RM 15.7B',
    label: 'Malaysia\'s AI market, growing ~30% year-on-year through 2030',
    src: 'MDEC · Statista',
  },
];
---

<section class="section section--stats-dark" id="stats">
  <div class="container-2xl">
    <div class="stats-header">
      <span class="stats-badge">{isZh ? '为什么是现在' : 'The evidence'}</span>
      <h2 class="stats-headline">
        {isZh ? (
          <>马来西亚的 AI<br/><span class="stats-headline__coral">时刻</span>已经到来。</>
        ) : (
          <>Malaysia's AI<br/>moment <span class="stats-headline__coral">is now.</span></>
        )}
      </h2>
      <p class="stats-sub">
        {isZh
          ? '四个数字,告诉您 2026 年为什么是必须学会用 AI 的一年。'
          : 'Four numbers. They tell you why 2026 is the year your team has to learn to use AI.'}
      </p>
    </div>

    <div class="stats-flow">
      {stats.map((s, i) => (
        <>
          <div class="stats-node">
            <div class="stats-node__index">{String(i + 1).padStart(2, '0')}</div>
            <div class="stats-node__num">{s.n}</div>
            <div class="stats-node__label">{s.label}</div>
            <div class="stats-node__src">{s.src}</div>
          </div>
          {i < stats.length - 1 && <div class="stats-connector" aria-hidden="true"></div>}
        </>
      ))}
    </div>

    <div class="stats-cta">
      <p class="stats-cta__text">
        {isZh
          ? '数字很清楚。2026 年,学会用 AI 的人会赢,不会的人会落后。'
          : 'The numbers are clear. In 2026, the people who know how to use AI win. The people who don\'t, fall behind.'}
      </p>
      <a href="#booking" class="btn btn--primary btn--lg">
        {isZh ? '预约 15 分钟免费咨询' : 'Book a free 15-min call'}
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>
  </div>
</section>

<style>
  .section--stats-dark {
    background: var(--foreground);
    color: oklch(96% 0.01 80);
    position: relative;
    overflow: hidden;
    border-top: 1px solid oklch(20% 0.005 60);
    border-bottom: 1px solid oklch(20% 0.005 60);
  }
  /* Subtle diagonal accent line, like the reference */
  .section--stats-dark::before {
    content: '';
    position: absolute;
    top: 0;
    right: -10%;
    width: 60%;
    height: 100%;
    background: linear-gradient(135deg, transparent 49%, oklch(58% 0.13 35 / 0.05) 50%, transparent 51%);
    pointer-events: none;
  }
  .section--stats-dark::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: -5%;
    width: 40%;
    height: 1px;
    background: linear-gradient(90deg, oklch(58% 0.13 35 / 0.4), transparent);
    pointer-events: none;
  }

  .stats-header {
    text-align: left;
    max-width: 720px;
    margin-bottom: 64px;
    position: relative;
    z-index: 1;
  }
  .stats-badge {
    display: inline-block;
    background: var(--primary);
    color: var(--primary-foreground);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 6px 12px;
    border-radius: 4px;
    margin-bottom: 24px;
  }
  .stats-headline {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw + 1rem, 4.5rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.025em;
    color: oklch(98% 0.005 80);
    margin: 0 0 20px;
  }
  .stats-headline__coral { color: var(--primary); }
  .stats-sub {
    font-size: 1.125rem;
    line-height: 1.5;
    color: oklch(75% 0.01 80);
    max-width: 56ch;
    margin: 0;
  }

  /* Process-flow stat cards */
  .stats-flow {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    position: relative;
    z-index: 1;
  }
  @media (min-width: 768px) {
    .stats-flow {
      grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr;
      align-items: stretch;
      gap: 16px;
    }
  }
  .stats-node {
    padding: 28px 24px;
    background: oklch(22% 0.008 60);
    border: 1px solid oklch(28% 0.01 60);
    border-radius: var(--radius-lg);
    display: flex;
    flex-direction: column;
    gap: 10px;
    position: relative;
    transition: border-color 200ms ease, transform 200ms ease;
  }
  .stats-node:hover {
    border-color: var(--primary);
    transform: translateY(-2px);
  }
  .stats-node__index {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    color: var(--primary);
    letter-spacing: 0.1em;
    margin-bottom: 4px;
  }
  .stats-node__num {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 2.5vw + 0.5rem, 3rem);
    font-weight: 700;
    line-height: 1;
    color: var(--primary);
    letter-spacing: -0.02em;
  }
  .stats-node__label {
    font-size: 14px;
    line-height: 1.5;
    color: oklch(90% 0.008 80);
    font-weight: 500;
  }
  .stats-node__src {
    font-size: 10px;
    line-height: 1.4;
    color: oklch(60% 0.008 80);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-top: auto;
    padding-top: 8px;
  }

  /* Connector line between nodes (desktop only) */
  .stats-connector {
    display: none;
  }
  @media (min-width: 768px) {
    .stats-connector {
      display: block;
      align-self: center;
      width: 16px;
      height: 1px;
      background: oklch(40% 0.01 60);
      position: relative;
    }
    .stats-connector::after {
      content: '';
      position: absolute;
      right: 0;
      top: 50%;
      transform: translateY(-50%);
      width: 6px;
      height: 6px;
      border-top: 1px solid oklch(40% 0.01 60);
      border-right: 1px solid oklch(40% 0.01 60);
      transform: translateY(-50%) rotate(45deg);
    }
  }

  /* Bottom CTA */
  .stats-cta {
    margin-top: 64px;
    padding-top: 48px;
    border-top: 1px solid oklch(28% 0.01 60);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    position: relative;
    z-index: 1;
  }
  .stats-cta__text {
    font-size: 1.0625rem;
    line-height: 1.5;
    color: oklch(85% 0.008 80);
    margin: 0;
    max-width: 56ch;
  }
  .stats-cta__text strong { color: var(--primary); }
</style>
