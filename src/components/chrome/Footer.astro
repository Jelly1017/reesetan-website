---
// src/components/chrome/Footer.astro
// 4-column footer (L14 anti-pattern: no 6-column). EN + 中文.

import { type Locale, SITE_PATHS, localizedPath } from '../../lib/i18n';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const year = new Date().getFullYear();
const t = (en: string, zh: string) => locale === 'zh' ? zh : en;
---

<footer class="footer">
  <div class="container-narrow">
    <div class="footer__grid">
      <!-- Brand column -->
      <div>
        <div style="font-family: var(--font-display); font-size: 22px; font-weight: 700; margin-bottom: 12px;">
          Reese<span style="color: var(--primary);">.</span>
        </div>
        <p style="font-size: 14px; color: var(--muted-foreground); line-height: 1.5; max-width: 32ch;">
          {t(
            'AI trainer for SMEs, corporate teams, and property professionals. HRDC Accredited. LPPEH 5 CPD Hours.',
            '为中小企业、企业团队和地产从业者提供 AI 培训。HRDC 认证,LPPEH 5 CPD 学时。'
          )}
        </p>
        <div style="display: flex; gap: 12px; margin-top: 16px;">
          <a href="https://www.linkedin.com/in/reesetan/" target="_blank" rel="noopener" aria-label="LinkedIn" style="color: var(--muted-foreground);">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.063 2.063 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
          <a href="https://www.facebook.com/HartamasAcademy" target="_blank" rel="noopener" aria-label="Facebook" style="color: var(--muted-foreground);">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
        </div>
      </div>

      <!-- Services column -->
      <div class="footer__col">
        <h4>{t('Services', '服务')}</h4>
        <ul>
          <li><a href={localizedPath(locale, '/#services')}>{t('SME & Corporate Training', '中小企业培训')}</a></li>
          <li><a href={localizedPath(locale, '/#services')}>{t('Hourly Consultation', '小时咨询')}</a></li>
          <li><a href={localizedPath(locale, '/#services')}>{t('Strategy Review', '营销策略审核')}</a></li>
          <li><a href={localizedPath(locale, '/#training')}>{t('Mastering AI Programme', 'Mastering AI 课程')}</a></li>
        </ul>
      </div>

      <!-- Company column -->
      <div class="footer__col">
        <h4>{t('Company', '公司')}</h4>
        <ul>
          <li><a href={localizedPath(locale, '/#about')}>{t('About Reese', '关于 Reese')}</a></li>
          <li><a href={localizedPath(locale, '/#past-training')}>{t('Past Training', '过往培训')}</a></li>
          <li><a href={localizedPath(locale, '/insights')}>{t('Insights', '见解')}</a></li>
          <li><a href={localizedPath(locale, '/#contact')}>{t('Contact', '联系')}</a></li>
        </ul>
      </div>

      <!-- Connect column -->
      <div class="footer__col">
        <h4>{t('Connect', '联系')}</h4>
        <ul>
          <li><a href="https://wa.me/60163356790" target="_blank" rel="noopener">WhatsApp</a></li>
          <li><a href="mailto:hello@reesetan.com">hello@reesetan.com</a></li>
          <li><a href="tel:+60163356790">+60 16-335 6790</a></li>
          <li style="font-size: 12px; color: var(--muted-foreground); margin-top: 8px;">
            {t('Mon–Fri 9:00–18:00 MYT', '周一至周五 9:00–18:00 (MYT)')}
          </li>
        </ul>
      </div>
    </div>

    <div class="footer__bottom">
      <div>© {year} Reese Tan. {t('All rights reserved.', '版权所有。')}</div>
      <div style="color: var(--muted-foreground);">
        {t('Privacy', '隐私')} · {t('Terms', '条款')}
      </div>
    </div>
  </div>
</footer>
