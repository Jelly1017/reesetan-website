---
// src/pages/index.astro
// The new landing page — all 8 sections + booking + contact form + structured data.

import Base from '../layouts/Base.astro';
import Hero from '../components/sections/Hero.astro';
import About from '../components/sections/About.astro';
import Stats from '../components/sections/Stats.astro';
import Services from '../components/sections/Services.astro';
import Training from '../components/sections/Training.astro';
import PastTraining from '../components/sections/PastTraining.astro';
import FAQ from '../components/sections/FAQ.astro';
import Contact from '../components/sections/Contact.astro';
import Booking from '../components/sections/Booking.astro';
import { personSchema, courseSchema, faqSchema, breadcrumbSchema, videoSchema } from '../lib/seo';

const en = 'en';
const enFAQs = [
  { q: 'How much time will my team actually save per week after this training?', a: 'Teams typically reclaim 10+ hours per week within the first month. The biggest time savings come from research (NotebookLM replaces 2-3 hours of reading and summarising), content creation (Canva AI + Gemini cut social and drafting time by 60-70%), and meeting follow-ups (Gemini turns a 1-hour meeting into 5 bullet points in 30 seconds). The 5-task action plan we leave you with is designed to lock in 10 hours in week one.' },
  { q: 'What will I personally be able to do after 5 hours that I can\'t do today?', a: 'You leave with 5 tangible deliverables you can use the next Monday: (1) 10 copy-paste prompt templates for your daily work, (2) a personal AI assistant (Gemini Gem) tuned to your voice, (3) a Canva template ready to reuse for social posts, (4) a Gamma presentation built from your own content, (5) a written 5-task action plan for the week ahead. No "we\'ll send the slides after" — the slide IS the deliverable.' },
  { q: 'How much can my company claim back through HRDCorp, and what\'s the ROI?', a: 'A typical 5-hour in-house workshop for up to 20 participants costs RM 6,000–RM 12,000. HRDCorp-registered companies can typically claim back 80–100% within 30–45 working days of filing a clean claim. On a 3-person marketing team saving 10 hours/week each, the freed time alone is worth RM 13,000+ per marketer per year — the training pays back in under 6 weeks, even before the HRDCorp claim lands.' },
  { q: 'Can I earn my 5 LPPEH CPD Hours AND have my agency claim HRDCorp at the same time?', a: 'Yes — and this is one of the most under-used wins in the Malaysian real estate market. The Mastering AI workshop is both LPPEH-approved (5 CPD Hours on your renewal record) AND HRDCorp-claimable (your agency recovers most or all of the fee). Past attendees have used it to (a) tick their annual CPD box, (b) get a productivity tool they actually use daily, and (c) save their firm RM 5,000+ in a single day.' },
  { q: 'Will my team actually keep using AI after the 5 hours, or will it fade after 2 weeks?', a: 'They keep using it — that\'s the whole point of the design. By the end of the session, every participant has (1) set up their personal AI assistant (Gemini Gem) in their own tone, (2) saved 10 prompt templates to their own account, (3) stored a Canva template in their own workspace, and (4) written their 5-task action plan. All the "homework" is done in the room — they leave already in day-2 working mode, not "I\'ll try it next week". This is why it\'s a 5-hour workshop, not a 2-hour lecture.' },
  { q: 'Could my team just learn this from YouTube for free instead of paying for the workshop?', a: 'They could — but it usually costs more. The hidden cost of free YouTube: (1) TIME — 10+ hours of scattered videos vs 5 hours of focused, guided work, (2) OUTPUT — after YouTube you have a "to-do list"; after the workshop you have a built AI assistant, saved templates, a finished deck, and an action plan, (3) QUALITY — YouTube teaches "what is Gemini"; we teach "how to make Gemini write your company\'s client email", (4) RISK — solo learning means wrong tools, missed features, and the 3-6 month "we tried AI and it didn\'t work" trajectory. One 5-hour workshop = the equivalent of years of YouTube, claimable under HRDCorp.' },
  { q: 'How is this 5-hour workshop different from the free AI webinars my team has already watched?', a: 'Webinars teach concepts. This workshop builds the workflow your team will use on Monday. Every participant leaves with their own AI assistant built, their own prompt templates saved, their own Canva template designed, and their own action plan written. No "we\'ll send you the slides later" — the slide IS the deliverable. It is the difference between watching a cooking show and cooking the meal. That\'s why past attendees consistently call it the most useful training day of their year.' },
];
---

<Base
  title="Reese Tan"
  description="Reese Tan is a HRDC-accredited AI Trainer and full-time Digital Marketing Strategist. Helping SME owners and corporate teams replace manual tasks with AI — so they can do more in less time. HRD Corp Claimable. LPPEH 5 CPD Hours. Based in Malaysia."
  path="/"
  jsonLd={[
    personSchema(),
    courseSchema(),
    videoSchema(),
    faqSchema(enFAQs),
    breadcrumbSchema([
      { name: 'Home', url: 'https://reesetan.com/' },
    ]),
  ]}
>
  <Hero locale={en} />
  <Stats locale={en} />
  <About locale={en} />
  <Services locale={en} />
  <Training locale={en} />
  <PastTraining locale={en} />
  <FAQ locale={en} />
  <Contact locale={en} />
  <Booking locale={en} />
</Base>
