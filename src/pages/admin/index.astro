---
// src/pages/admin/index.astro
// Login page. If user already has a session, redirect to /admin/dashboard.

import Base from '../../layouts/Base.astro';
import { createServerSupabase, supabaseConfigured } from '../../lib/supabase';

let isLoggedIn = false;
let setupNeeded = !supabaseConfigured();

if (!setupNeeded) {
  const supabase = createServerSupabase(Astro.cookies);
  const { data: { session } } = await supabase.auth.getSession();
  isLoggedIn = Boolean(session);
  if (isLoggedIn) return Astro.redirect('/admin/dashboard');
}
---

<Base
  title="Admin Login"
  description="Sign in to the Reese Tan admin dashboard."
  path="/admin"
  hideNav={true}
  hideFooter={true}
  hideWhatsApp={true}
>
  <div style="min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 24px; background: var(--background);">
    <div style="width: 100%; max-width: 420px;">

      <a href="/" style="display: inline-flex; align-items: center; gap: 8px; margin-bottom: 32px; color: var(--muted-foreground); font-size: 14px;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Back to site
      </a>

      <div class="card" style="padding: 40px;">
        <div style="text-align: center; margin-bottom: 32px;">
          <div style="font-family: var(--font-display); font-size: 28px; font-weight: 700; margin-bottom: 4px;">
            Reese<span style="color: var(--primary);">.</span>
          </div>
          <div style="font-size: 13px; color: var(--muted-foreground); text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600;">Admin CRM</div>
        </div>

        {setupNeeded ? (
          <div class="form-status form-status--error" style="margin-bottom: 16px;">
            <strong>Setup needed.</strong><br>
            Configure <code>PUBLIC_SUPABASE_URL</code> and <code>PUBLIC_SUPABASE_ANON_KEY</code> in your <code>.env</code> file. See the README.
          </div>
        ) : (
          <form id="login-form">
            <div style="margin-bottom: 16px;">
              <label class="form-label" for="email">Email</label>
              <input id="email" name="email" type="email" required class="input" placeholder="you@example.com" autocomplete="email" />
            </div>
            <div style="margin-bottom: 16px;">
              <label class="form-label" for="password">Password</label>
              <input id="password" name="password" type="password" required class="input" placeholder="••••••••" autocomplete="current-password" />
            </div>

            <div id="login-error" class="form-status form-status--error" style="margin-bottom: 16px; display: none;"></div>

            <button type="submit" class="btn btn--primary" style="width: 100%; justify-content: center;" id="login-button">
              Sign in
            </button>

            <p style="margin-top: 16px; font-size: 13px; color: var(--muted-foreground); text-align: center;">
              Lost access? Create a new user in <a href="https://supabase.com/dashboard" target="_blank" rel="noopener" style="color: var(--primary);">Supabase Dashboard → Authentication → Users</a>.
            </p>
          </form>
        )}
      </div>
    </div>
  </div>
</Base>

{!setupNeeded && (
  <script>
    import { createBrowserSupabase } from '../../lib/supabase';
    const supabase = createBrowserSupabase();
    const form = document.getElementById('login-form') as HTMLFormElement;
    const errorEl = document.getElementById('login-error') as HTMLDivElement;
    const button = document.getElementById('login-button') as HTMLButtonElement;

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorEl.style.display = 'none';
      button.disabled = true;
      button.textContent = 'Signing in…';

      const fd = new FormData(form);
      const email = String(fd.get('email') || '');
      const password = String(fd.get('password') || '');

      const { error } = await supabase.auth.signInWithPassword({ email, password });

      if (error) {
        errorEl.textContent = error.message;
        errorEl.style.display = 'block';
        button.disabled = false;
        button.textContent = 'Sign in';
        return;
      }

      window.location.href = '/admin/dashboard';
    });
  </script>
)}
