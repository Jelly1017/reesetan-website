# =============================================================================
# REESE TAN — Environment Variables
# Copy this file to `.env` and fill in your real values.
#
# Where to get each key:
#   - Supabase: https://supabase.com/dashboard/project/_/settings/api
#   - Resend:   https://resend.com/api-keys
#   - Cal.com:  https://cal.com/event-types (your event-type link)
#
# Anything left as `change-me` will gracefully degrade (form still works,
# but no DB storage / no email / no calendar embed).
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED for the custom CRM (admin login + lead storage)
# -----------------------------------------------------------------------------
# Get from: Supabase Dashboard > Project Settings > API
PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
PUBLIC_SUPABASE_ANON_KEY="eyJ...your-anon-key..."

# -----------------------------------------------------------------------------
# REQUIRED for email notifications (Resend — 100 emails/day free)
# -----------------------------------------------------------------------------
# Get from: https://resend.com/api-keys
RESEND_API_KEY="re_..."

# Email that receives new-lead notifications
NOTIFY_EMAIL="hello@reesetan.com"

# From address (must be a verified domain in Resend)
FROM_EMAIL="Reese Tan <hello@reesetan.com>"

# -----------------------------------------------------------------------------
# REQUIRED for consultation booking (Cal.com)
# -----------------------------------------------------------------------------
# Your Cal.com event-type link, e.g. "reesetan/15min"
# Get from: https://cal.com/event-types > click your event > "Copy link"
PUBLIC_CAL_COM_LINK="reesetan/15min"

# -----------------------------------------------------------------------------
# Site URL (for absolute links in JSON-LD, OG, emails)
# -----------------------------------------------------------------------------
PUBLIC_SITE_URL="https://reesetan.com"
